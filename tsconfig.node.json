{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    // composite projects must emit; send the emit somewhere harmless. Without
    // this, `tsc -b` writes vite.config.js/.d.ts into the repo root — and Vite
    // loads vite.config.js BEFORE vite.config.ts, so a stale committed copy
    // silently becomes the build config on CI.
    "outDir": "./node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts"]
}
